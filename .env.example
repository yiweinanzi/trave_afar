# =============================================================================
# GoAfar 环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据需要修改
# cp .env.example .env

# =============================================================================
# 环境配置
# =============================================================================
GOAFAR_ENV_MODE=dev                    # 环境模式: dev, staging, prod
GOAFAR_INSTANCE_ID=goafar-1            # 实例ID
GOAFAR_REGION=default                   # 区域/可用区

# =============================================================================
# 运行时配置
# =============================================================================
GOAFAR_LOG_LEVEL=INFO                   # 日志级别: DEBUG, INFO, WARNING, ERROR
GOAFAR_WORKERS=0                        # 工作进程数 (0=CPU核心数)
GOAFAR_REQUEST_TIMEOUT=300              # 请求超时(秒)
GOAFAR_PROFILING=false                   # 启用性能分析

# =============================================================================
# API 配置
# =============================================================================
GOAFAR_API_HOST=0.0.0.0                 # 监听地址
GOAFAR_API_PORT=8000                     # 监听端口
GOAFAR_CORS_ORIGINS=*                    # CORS允许的源
GOAFAR_CORS_METHODS=GET,POST,OPTIONS    # CORS允许的方法
GOAFAR_CORS_HEADERS=*                    # CORS允许的头

# 限流配置
GOAFAR_RATE_LIMIT_ENABLED=false          # 启用限流
GOAFAR_RATE_LIMIT_REQUESTS=100          # 限流请求数
GOAFAR_RATE_LIMIT_WINDOW=60              # 限流时间窗(秒)

# API密钥配置
GOAFAR_API_KEY_REQUIRED=false            # 需要API密钥
GOAFAR_API_KEY_HEADER=X-API-Key          # API密钥头名称

# =============================================================================
# LLM 配置
# =============================================================================
GOAFAR_LLM_ENABLED=true                  # 启用LLM
GOAFAR_LLM_GPU=true                      # 使用GPU
GOAFAR_LLM_MODEL=models/Qwen3-8B         # LLM模型路径
GOAFAR_LLM_MAX_TOKENS=512                # 最大生成token数
GOAFAR_LLM_TEMPERATURE=0.7               # 采样温度
GOAFAR_LLM_TOP_P=0.9                     # Top-P采样
GOAFAR_LLM_INFERENCE_MAX_LENGTH=2048      # 最大推理长度

# 模型量化
GOAFAR_LLM_8BIT=false                    # 8位量化
GOAFAR_LLM_4BIT=false                    # 4位量化

# LoRA配置
GOAFAR_LLM_LORA=false                    # 使用LoRA
GOAFAR_LLM_LORA_PATH=null                # LoRA路径

# =============================================================================
# Embedding 配置
# =============================================================================
GOAFAR_EMBEDDING_MODEL=models/Qwen3-Embedding-4B
GOAFAR_EMBEDDING_GPU=true
GOAFAR_EMBEDDING_BATCH_SIZE=32
GOAFAR_EMBEDDING_QUANT=none               # 量化: none, 4bit, 8bit

# =============================================================================
# 重排序配置
# =============================================================================
GOAFAR_RERANK_ENABLED=true
GOAFAR_RERANK_MODEL=true
GOAFAR_RERANK_PATH=models/Qwen3-Reranker-4B

# =============================================================================
# 外部服务
# =============================================================================
GOAFAR_OSRM_URL=http://router.project-osrm.org

# =============================================================================
# 缓存配置
# =============================================================================
GOAFAR_CACHE_ENABLED=true
GOAFAR_CACHE_EMBEDDING_TTL=86400         # 嵌入缓存TTL(秒)
GOAFAR_CACHE_ROUTING_TTL=3600            # 路由缓存TTL(秒)
GOAFAR_CACHE_MAX_ITEMS=10000

# =============================================================================
# 监控配置
# =============================================================================
GOAFAR_PROM_ENABLED=true                 # Prometheus启用
GOAFAR_PROM_PORT=9090                    # Prometheus端口
GOAFAR_PROM_PATH=/metrics                # 指标路径

GOAFAR_TRACING_ENABLED=false             # 分布式追踪启用
GOAFAR_TRACING_ENDPOINT=null             # 追踪端点
GOAFAR_TRACING_SAMPLE_RATE=0.1          # 采样率

# =============================================================================
# MLflow 配置
# =============================================================================
GOAFAR_MLFLOW_ENABLED=true
GOAFAR_MLFLOW_URI=null                   # MLflow服务器地址
GOAFAR_MLFLOW_EXPERIMENT=null            # 实验名称

# =============================================================================
# 日志配置
# =============================================================================
GOAFAR_LOG_DIR=logs                      # 日志目录
GOAFAR_LOG_MAX_SIZE=10                   # 最大文件大小(MB)
GOAFAR_LOG_BACKUP_COUNT=5                # 备份文件数量
GOAFAR_LOG_FORMAT=text                   # 格式: text, json
GOAFAR_LOG_SANITIZE=true                 # 敏感信息脱敏

# =============================================================================
# Grafana 配置 (用于 docker-compose)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# 生产环境覆盖
# =============================================================================
# 当 GOAFAR_ENV_MODE=prod 时生效
# GOAFAR_CORS_ORIGINS=https://api.goafar.example.com
# GOAFAR_API_KEY_REQUIRED=true
# GOAFAR_LLM_8BIT=true
